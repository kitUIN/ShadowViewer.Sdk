<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>ShadowViewer.Sdk</RootNamespace>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<LangVersion>preview</LangVersion>
		<PackageId>ShadowViewer.Sdk</PackageId>
		<Authors>kitUIN</Authors>
		<Version>3.2.2</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/kitUIN/ShadowViewer.Sdk</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kitUIN/ShadowViewer.Sdk</RepositoryUrl>
		<Description>✨ ShadowViewer Core | Development SDK✨</Description>
		<Copyright>Copyright 2023-2026</Copyright>
		<PackageTags>kitUIN;wasdk;ShadowViewer;winui</PackageTags>
		<PackageOutputPath>..\..\..\NugetPackages</PackageOutputPath>
		<NoWarn>MSB3277</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<DefaultLanguage>zh-CN</DefaultLanguage>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
		<PackageReference Include="CommunityToolkit.WinUI.Media" Version="8.2.251219" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="FluentIcons.WinUI" Version="2.0.316" />
		<PackageReference Include="ShadowPluginLoader.WinUI" Version="3.1.8" />
		<PackageReference Include="SqlSugarCore" Version="5.1.4.211" />
		<PackageReference Include="System.Private.Uri" Version="4.3.2" />
	</ItemGroup>
	<ItemGroup>
		<None Include="$(OutputPath)\**\*.xbf" Pack="true" PackagePath="lib\net8.0-windows10.0.22621\" />
		<!-- 修复nuget打包后resw未在主应用合并 -->
		<None Include="Strings\**\*.resw" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="ShadowViewer.Sdk.targets" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ShadowViewer.Controls" Version="1.3.1" />
		<PackageReference Include="ShadowViewer.Controls.Notification" Version="1.2.1" />
	</ItemGroup>
</Project>